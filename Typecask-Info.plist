<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the generated Info.plist can't say through INFOPLIST_KEY_ build settings, which hold no lists.
     Merged into it. Outside Typecask/, which the target copies whole, so it isn't a resource too. -->
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.marquard.Typecask</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>typecask</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
