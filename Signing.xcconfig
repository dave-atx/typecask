// Code signing, kept out of the project so each contributor signs with their own team.
//
// Set your Apple Developer team in Signing.local.xcconfig, which git ignores:
//
//     DEVELOPMENT_TEAM = ABCDE12345
//
// Simulator builds need no team. The TestFlight workflow writes the local file from the repository's
// APPLE_TEAM_ID variable.
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
