// Code signing, kept out of the project so each contributor signs with their own team.
//
// Set your Apple Developer team in Signing.local.xcconfig, which git ignores:
//
//     DEVELOPMENT_TEAM = ABCDE12345
//
// Simulator builds need no team. Xcode Cloud writes the local file from CI_TEAM_ID in
// ci_scripts/ci_post_clone.sh.
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
